# Copy this file to terraform.tfvars and update all REPLACE_* values.

aws_region   = "us-west-2"
project_name = "pvi"
environment  = "prod"

# Set to your GitHub repo (owner/repo) so Terraform creates OIDC deploy role.
github_repository = "PVI-Engineers/website"
github_branch     = "main"

# Site is served on the CloudFront domain (xxxx.cloudfront.net).
# Set use_custom_domain = true and fill domain_name when you are ready to attach a domain.
use_custom_domain = false
# domain_name    = "example.com"
# hosted_zone_id = ""
# api_subdomain  = "api"

# Bucket names for this project.
frontend_bucket_name  = "pvi-prod-frontend"
resume_bucket_name    = "pvi-prod-resumes"
artifacts_bucket_name = "pvi-prod-artifacts"

# Optional: leave empty if you do not use SSH keypair login.
key_pair_name       = "REPLACE_EC2_KEYPAIR_NAME"
admin_ingress_cidr  = "REPLACE_YOUR_PUBLIC_IP/32"
enable_ssh_ingress  = true
instance_type       = "t2.micro"
db_instance_class   = "db.t3.micro"
db_allocated_storage = 20

db_name     = "pvi_careers"
db_username = "pvi_admin"
# RDS password cannot contain: /  @  "  or spaces.
db_password = "REPLACE_WITH_STRONG_DB_PASSWORD"

mail_from_address = "no-reply@pviengineers.com"
company_mail_to   = "hr@pviengineers.com"
ses_region        = "us-west-2"

jwt_secret = "REPLACE_WITH_LONG_RANDOM_JWT_SECRET_MIN_32_CHARS"

bootstrap_admin_username  = "admin@pvi.local"
bootstrap_admin_password  = "Admin@123"
bootstrap_admin_full_name = "PVI Admin"
bootstrap_admin_email     = "admin@pviengineers.com"

bootstrap_hr_username  = "hr@pvi.local"
bootstrap_hr_password  = "Hr@123"
bootstrap_hr_full_name = "PVI HR"
bootstrap_hr_email     = "hr@pviengineers.com"

bootstrap_employee_username  = "employee@pvi.local"
bootstrap_employee_password  = "Employee@123"
bootstrap_employee_full_name = "PVI Employee"
bootstrap_employee_email     = "employee@pviengineers.com"

extra_frontend_urls = []

alarm_email = "alerts@pviengineers.com"

# create_www_record is used only when use_custom_domain = true.
create_www_record         = true
rds_skip_final_snapshot   = true
rds_deletion_protection   = true
enable_waf                = true
waf_rate_limit            = 2000
