#!/bin/bash
set -euo pipefail
ENV_FILE=/opt/pvi/application.env
touch "$ENV_FILE"

set_env() {
  key="$1"
  value="$2"
  if grep -q "^$${key}=" "$ENV_FILE"; then
    sed -i "s|^$${key}=.*|$${key}=$${value}|" "$ENV_FILE"
  else
    printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"
  fi
}

set_env APP_BOOTSTRAP_ADMIN_USERNAME '${admin_username}'
set_env APP_BOOTSTRAP_ADMIN_PASSWORD '${admin_password}'
set_env APP_BOOTSTRAP_HR_USERNAME '${hr_username}'
set_env APP_BOOTSTRAP_HR_PASSWORD '${hr_password}'
set_env APP_BOOTSTRAP_EMPLOYEE_USERNAME '${employee_username}'
set_env APP_BOOTSTRAP_EMPLOYEE_PASSWORD '${employee_password}'

systemctl daemon-reload
systemctl restart pvi-careers-api
